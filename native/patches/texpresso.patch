+/* Bounded, positioned Unicode characters for the editor text layer. */
+static fz_buffer *preview_text_layer(fz_context *ctx, fz_display_list *list)
+{
+  fz_stext_page *page = NULL;
+  fz_buffer *buf = NULL;
+  fz_var(page); fz_var(buf);
+  fz_try(ctx) {
+    page = fz_new_stext_page_from_display_list(ctx, list, NULL);
+    buf = fz_new_buffer(ctx, 8192);
+    fz_append_string(ctx, buf, "[");
+    int count = 0;
+    for (fz_stext_block *b = page->first_block; b && count < 8000; b = b->next) {
+      if (b->type != FZ_STEXT_BLOCK_TEXT) continue;
+      for (fz_stext_line *l = b->u.t.first_line; l && count < 8000; l = l->next) {
+        for (fz_stext_char *c = l->first_char; c && count < 8000; c = c->next) {
+          fz_rect r = fz_rect_from_quad(c->quad);
+          if (c->c <= 0 || c->c > 0x10ffff || (c->c >= 0xd800 && c->c <= 0xdfff) ||
+              !isfinite(r.x0) || !isfinite(r.y0) || !isfinite(r.x1) || !isfinite(r.y1) || r.x1 <= r.x0 || r.y1 <= r.y0) continue;
+          fz_append_printf(ctx, buf, "%s[%d,%.3f,%.3f,%.3f,%.3f]", count ? "," : "", c->c, r.x0, r.y0, r.x1, r.y1);
+          count++;
+        }
+      }
+    }
+    fz_append_string(ctx, buf, "]");
+  }
+  fz_always(ctx) { fz_drop_stext_page(ctx, page); }
+  fz_catch(ctx) { fz_drop_buffer(ctx, buf); fz_rethrow(ctx); }
+  return buf;
+}
